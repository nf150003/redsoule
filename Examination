<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nirjhor Examination Management System</title>

<style>

/* RESET */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial;
    min-height:100vh;
    background:linear-gradient(-45deg,#1e3c72,#2a5298,#23a6d5,#23d5ab);
    background-size:400% 400%;
    animation:bg 12s ease infinite;
    color:white;
}

/* BACKGROUND ANIMATION */
@keyframes bg{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

/* HEADER */
.header{
    text-align:center;
    padding:25px;
}

.header h1{
    font-size:34px;
}

.header p{
    opacity:0.8;
}

/* TOP CLOCK + CALENDAR */
.topbar{
    width:92%;
    margin:20px auto;
    display:flex;
    gap:20px;
    justify-content:center;
    flex-wrap:wrap;
}

.top-card{
    background:rgba(255,255,255,0.15);
    backdrop-filter:blur(10px);
    border-radius:60px;
    padding:15px 25px;
    display:flex;
    align-items:center;
    gap:15px;
    min-width:280px;
    box-shadow:0 8px 20px rgba(0,0,0,0.2);
    transition:0.4s;
}

.top-card:hover{
    transform:scale(1.05);
    background:rgba(255,255,255,0.22);
}

.circle{
    width:65px;
    height:65px;
    border-radius:50%;
    background:rgba(255,255,255,0.25);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
}

.text h3{
    font-size:22px;
}

.text p{
    font-size:13px;
    opacity:0.8;
}

/* DASHBOARD */
.container{
    width:92%;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    padding-bottom:40px;
}

/* CARDS */
.card{
    background:rgba(255,255,255,0.12);
    backdrop-filter:blur(10px);
    border-radius:20px;
    padding:25px;
    text-align:center;
    box-shadow:0 8px 20px rgba(0,0,0,0.2);
    transition:0.4s;
    cursor:pointer;
    position:relative;
}

.card:hover{
    transform:translateY(-10px) scale(1.05);
    background:rgba(255,255,255,0.18);
}

.icon{
    font-size:50px;
    margin-bottom:10px;
}

.card h2{
    font-size:22px;
}

.card p{
    font-size:13px;
    opacity:0.85;
}

/* FOOTER */
.footer{
    text-align:center;
    padding:20px;
    opacity:0.7;
}

/* MOBILE */
@media(max-width:600px){
    .header h1{font-size:24px;}
}

</style>
</head>

<body>

<!-- HEADER -->
<div class="header">
    <h1>🎓 Nirjhor Examination Management System</h1>
    <p>Smart School ERP Dashboard</p>
</div>

<!-- CLOCK + CALENDAR -->
<div class="topbar">

    <div class="top-card">
        <div class="circle">🕒</div>
        <div class="text">
            <h3 id="clock">00:00:00</h3>
            <p>Live Clock</p>
        </div>
    </div>

    <div class="top-card">
        <div class="circle">📅</div>
        <div class="text">
            <h3 id="date"></h3>
            <p>Today</p>
        </div>
    </div>

</div>

<!-- DASHBOARD -->
<div class="container">

    <div class="card"><div class="icon">📚</div><h2>Exams</h2><p>Manage exams</p></div>
    <div class="card"><div class="icon">👨‍🎓</div><h2>Students</h2><p>Student data</p></div>
    <div class="card"><div class="icon">📄</div><h2>Papers</h2><p>Question papers</p></div>
    <div class="card"><div class="icon">📊</div><h2>Results</h2><p>Exam results</p></div>
    <div class="card"><div class="icon">🖨️</div><h2>Print</h2><p>Print system</p></div>
    <div class="card"><div class="icon">🔐</div><h2>Admin</h2><p>Control panel</p></div>

    <div class="card"><div class="icon">📝</div><h2>Attendance</h2><p>Daily records</p></div>
    <div class="card"><div class="icon">📅</div><h2>Timetable</h2><p>Auto schedule</p></div>
    <div class="card"><div class="icon">📢</div><h2>Notices</h2><p>Announcements</p></div>
    <div class="card"><div class="icon">☁️</div><h2>Cloud</h2><p>Firebase backup</p></div>
    <div class="card"><div class="icon">📈</div><h2>Analytics</h2><p>Reports</p></div>
    <div class="card"><div class="icon">⚙️</div><h2>Settings</h2><p>System config</p></div>

    <div class="card"><div class="icon">🏫</div><h2>Rooms</h2><p>Class rooms</p></div>
    <div class="card"><div class="icon">👩‍🏫</div><h2>Teachers</h2><p>Staff system</p></div>
    <div class="card"><div class="icon">📦</div><h2>Inventory</h2><p>Store system</p></div>
    <div class="card"><div class="icon">💳</div><h2>Fees</h2><p>Payment system</p></div>
    <div class="card"><div class="icon">📥</div><h2>Downloads</h2><p>Files</p></div>
    <div class="card"><div class="icon">📤</div><h2>Uploads</h2><p>Upload data</p></div>
    <div class="card"><div class="icon">🔍</div><h2>Search</h2><p>Find records</p></div>
    <div class="card"><div class="icon">📧</div><h2>Email</h2><p>Messaging system</p></div>
    <div class="card"><div class="icon">🧾</div><h2>Admit Cards</h2><p>Generate cards</p></div>

</div>

<!-- FOOTER -->
<div class="footer">
© 2026 Nirjhor Examination Management System
</div>

<!-- SCRIPT -->
<script>

// CLOCK
function updateClock(){
    let now = new Date();
    let h = now.getHours().toString().padStart(2,'0');
    let m = now.getMinutes().toString().padStart(2,'0');
    let s = now.getSeconds().toString().padStart(2,'0');

    document.getElementById("clock").innerHTML = h+":"+m+":"+s;
}
setInterval(updateClock,1000);
updateClock();

// DATE
document.getElementById("date").innerHTML = new Date().toDateString();

</script>

</body>
</html>
